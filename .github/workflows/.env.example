# Email notification secrets for the Ansible Molecule CI workflow.
# Add these as GitHub Actions secrets in:
#   Settings → Secrets and variables → Actions → New repository secret
#
# All secrets are optional. If not configured, the email step is silently
# skipped (continue-on-error: true) and tests still run normally.

# SMTP server hostname (e.g. smtp.gmail.com, smtp.mailgun.org)
MAIL_SERVER=

# SMTP authentication credentials
MAIL_USERNAME=
MAIL_PASSWORD=

# Recipient address for failure notifications
MAIL_TO=

# Sender address shown in the From: header
MAIL_FROM=
